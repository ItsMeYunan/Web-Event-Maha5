# ==============================================================================
# DISCORD LIVE REAL-TIME VOTING - ENVIRONMENT CONFIGURATION
# Salin file ini menjadi .env lalu isi sesuai server Discord Anda
# ==============================================================================

# 1. Discord Bot Credentials (Dapatkan dari https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_GUILD_ID=                  # Opsional: Kosongkan untuk mendukung semua server
DISCORD_STAGE_CHANNEL_ID=          # Opsional: kosongkan -> pakai stage channel admin saat initiate
DISCORD_VOICE_GATE_ENABLED=false   # true = hanya member di stage channel sesi yang boleh vote

# Client secret dipakai hanya oleh backend saat token exchange (bukan browser).
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# 1b. Dashboard login (frontend, /dashboard)
# Client ID yang sama seperti di atas, di-expose ke browser oleh Vite.
# Tambahkan <base_url>/dashboard sebagai Redirect URI di Discord Developer Portal.
VITE_DISCORD_CLIENT_ID=your_discord_client_id_here

# 2. Backend & Secret Key
BACKEND_URL=http://localhost:3000
HOST=0.0.0.0
PORT=3000
BACKEND_ADMIN_KEY=your_secret_admin_key_here

# 3. Voting Parameters (Opsional / Override)
COMMAND_PREFIX=!vote
VOTE_MODE=ONE_TIME                 # ONE_TIME atau COOLDOWN
COOLDOWN_SECONDS=15
