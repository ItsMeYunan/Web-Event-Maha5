# Configurable via this file or commands
vote:
  cooldown_seconds: 0        # 0 = one-time only; >0 = seconds between re-votes
  require_voice_channel: false   # true = must be in a voice channel to vote
  channel: null              # default voting channel id (optional, unused for now)

web:
  host: "127.0.0.1"
  port: 8080
  base_url: "http://127.0.0.1:8080"   # used to build links

ui:
  max_bar_width_px: 600      # max container size for horizontal bars
  background_color: "#00ff00"   # hex color, defaults to green screen for OBS chroma key

widget:
  # container background colors, one per candidate (cycled if fewer than candidates)
  container_colors:
    - "#1f77b4"
    - "#ff7f0e"
    - "#2ca02c"
    - "#d62728"

bot:
  token: "YOUR_BOT_TOKEN"
